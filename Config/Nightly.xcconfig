#include "Release.xcconfig"

// Native Nightly is its own app, installed beside Native (like VS Code Insiders): its own name,
// bundle identifier, feed and host, so the two never replace or talk to each other.
NATIVE_PRODUCT_NAME = Native Nightly
NATIVE_BUNDLE_IDENTIFIER_SUFFIX = .nightly
NATIVE_CHANNEL_CONDITION = NATIVE_NIGHTLY
NATIVE_FEED_URL = $(NATIVE_NIGHTLY_FEED_URL)
NATIVE_HOST_CHANNEL = nightly

// TODO(icon): the app icon owner adds the Nightly icon to the app target (for example
// native/AppIconNightly.icon, from design/app-icon/Nightly.icon) and sets its name here.
NATIVE_APP_ICON_NAME = AppIcon
