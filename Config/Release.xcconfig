#include "Shared.xcconfig"

NATIVE_FEED_URL = $(NATIVE_STABLE_FEED_URL)

// Notarization requires the hardened runtime on every executable, the host helper's included.
ENABLE_HARDENED_RUNTIME = YES

// Strip every Release and Nightly build, not only archives, so `just install` runs the same binaries
// users download: unstripped, the app binary is about 37 MB bigger (docs/app-size.md). The symbols
// live on in the dSYMs (DEBUG_INFORMATION_FORMAT = dwarf-with-dsym), which Sentry symbolicates from.
DEPLOYMENT_POSTPROCESSING = YES
STRIP_INSTALLED_PRODUCT = YES
STRIP_STYLE = all
